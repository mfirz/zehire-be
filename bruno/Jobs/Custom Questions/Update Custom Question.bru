meta {
  name: Update Custom Question
  type: http
  seq: 8
}

put {
  url: {{base_url}}/v1/jobs/{{job_id}}/custom-questions/{{custom_question_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "questionText": "Updated question text here?",
    "required": false
  }
}

docs {
  Update a custom question.

  Only provided fields will be updated.

  **Updatable fields:** questionText, required, and other type-specific fields.
}
