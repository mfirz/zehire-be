meta {
  name: Update Application Status
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/v1/applications/{{application_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "status": "screening",
    "triageStatus": "SHORTLIST"
  }
}

docs {
  Update the status and/or triage status of an application.
}
