meta {
  name: Get Custom Question
  type: http
  seq: 7
}

get {
  url: {{base_url}}/v1/jobs/{{job_id}}/custom-questions/{{custom_question_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get a single custom question by ID.

  Returns the full custom question details.
}
