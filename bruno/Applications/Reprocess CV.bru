post {
  url: {{base_url}}/v1/applications/{{application_id}}/cv/reprocess
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Reprocess the CV for an application.

  Triggers re-extraction and re-analysis of the CV.
}
